# LS증권 xingAPI COM 로그인 정보

# 이 파일을 복사하여 .env 로 저장한 뒤 실제 값을 입력하세요.

#   copy .env.example .env

#

# ※ xingAPI(COM)는 HTS 아이디/비밀번호로 로그인합니다.

#   LS Open API REST용 App Key / Secret Key 는 이 봇에서 사용하지 않습니다.



# HTS 로그인 아이디·비밀번호

XING_USER_ID=

XING_USER_PW=



# 실전 투자 시 공인인증서 비밀번호 (모의투자는 비워두기)

XING_CERT_PW=



# 주문 계좌 (비우면 로그인 후 첫 번째 계좌 자동 선택)

XING_ACCOUNT=

# ★ 계좌 주문비밀번호 (HTS 매매 시 4자리 — XING_USER_PW 와 별개!)
#    로그인 비번 넣으면 01796 잠금 날 수 있음

XING_ACCOUNT_PW=0000



# 서버 (모의: demo.ebestsec.co.kr / 실전: hts.ebestsec.co.kr)

XING_SERVER=hts.ebestsec.co.kr

XING_SERVER_PORT=20001



# ── 전략 파라미터 ─────────────────────────────────────────────

# 이동평균 틱 수

STRATEGY_MA_WINDOW=80

# MA 대비 매수 지정가 이격 (1.5 = 1.5%, 0.015 도 가능)

STRATEGY_ENTRY_GAP_PCT=1.5

# 체결가 대비 익절 지정가 (1.5 = 1.5%)

STRATEGY_TAKE_PROFIT_PCT=1.5

# 매수 체결 후 타임컷(초)

STRATEGY_TIME_STOP_SEC=4

# 주문 수량 — 반드시 1 (겹침 매수 방지)

STRATEGY_ORDER_QTY=1

# 매수 정정(CSPAT00700) rate limit — GetTRCountPerSec × 비율 (0.85 권장)

STRATEGY_AMEND_SAFETY_RATIO=0.85

# 정정 TR 최소 간격(ms) — in-flight 왕복 고려

STRATEGY_AMEND_MIN_INTERVAL_MS=50

